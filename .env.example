# Local dev: use Vite proxy to avoid CORS (see vite.config.ts server.proxy)
VITE_API_BASE_URL=/api/v1

# Off by default (real backend for everything). Set to "true" to allow a
# localStorage-backed mock layer in src/api/client.ts to serve some
# responses instead. Even when true, an extensive `useRealBackend` URL
# allowlist in that file routes most endpoints — including admin, ward,
# billing, pharmacy, laboratory, radiology, auth, tenants, subscriptions,
# and invoices — to the real backend regardless; check that allowlist for
# the current exact scope before assuming any given page is mocked.
VITE_USE_MOCK=false
